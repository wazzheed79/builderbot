# ==========================================
# BuilderBot Environment Configuration
# ==========================================

# 1. Google Gemini AI API (Powers real-time voice & trade quote extraction)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Configuration (Client-Side)
# Get your project credentials at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Supabase Service Role Key (SERVER-SIDE ONLY)
# Used by secure API routes for token-based customer lookups and digital signing.
# WARNING: NEVER prefix with NEXT_PUBLIC_ or expose this secret key to the browser!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Stripe Payments & Subscriptions (Phase 4 Monetisation)
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook secret for listening to completed payments:
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

