# ==========================================
# Chuffed Quotes — environment settings
# The product name is in lib/brand.mjs, not here.
# ==========================================

# 1. Google Gemini (optional). Leave the key blank to stay on rough estimates.
# Create a key at https://aistudio.google.com/app/apikey
# Set a monthly spending cap in Google before you use it with real customers.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model id. New Google keys cannot use gemini-2.5-flash.
# Leave this as gemini-3.5-flash unless you need a different model.
# If Google returns an error (including 404, 429, or 503) or the request
# times out, the app still builds a rough estimate instead of showing an error.
GEMINI_MODEL=gemini-3.5-flash

# 2. Supabase (sign-in and sync). From Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Supabase service role (server only). Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Optional public site address, with no slash at the end.
# Example: https://www.example.co.uk
# Leave blank to use relative links and the address of the open site.
NEXT_PUBLIC_APP_URL=

# 5. Optional email shown if feedback cannot be stored.
# Leave blank to use the owner email in lib/brand.mjs.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# 6. Card payments are switched off in this beta. Leave these blank.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
